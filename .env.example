# Postgres connection string. Provider-agnostic on purpose — swap this line to move
# providers (Neon -> Railway -> Hostinger PG -> RDS -> DO), nothing else changes.
# sslmode suffix decides TLS behavior (pg 8.x, tested):
#   sslmode=require    -> treated as verify-full, needs a trusted CA (works on Neon)
#   sslmode=no-verify  -> TLS on, skips cert validation (self-signed certs)
#   sslmode=disable    -> no TLS (local/trusted network only)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Fixed landing page the redirect sends traffic to (v1: no split test)
LANDING_PAGE_URL=https://example.com/lp

# Shared secret configured on the GGCheckout webhook (x-secret and/or Bearer)
GGCHECKOUT_WEBHOOK_SECRET=

# Meta System User token (ads_read + pixel management)
META_CAPI_TOKEN=
# Must include the "act_" prefix — a bare numeric ad account ID will fail every Marketing API call.
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# Optional: Events Manager test code, remove once CAPI verified live
META_TEST_EVENT_CODE=

# true = skip real Meta CAPI sends (simulated + logged), allow "dev-secret" on the
# GGCheckout webhook regardless of GGCHECKOUT_WEBHOOK_SECRET, verbose console logging.
# Never set this in production.
DEV_MODE=false
